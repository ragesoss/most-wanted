{
  "_about": "Central mapping from Wikidata P31 classes to compiler decisions and on-device classifier vocabulary. This file is load-bearing: the raw 'missing P18' signal is dominated by org-shaped items that geocode to office addresses and are not photographable subjects (in the Seattle test box, the single most common class was 'nonprofit organization'). Per PLAN.md, the label vocabulary is mapped once, centrally — clients must not improvise their own mapping.",
  "_decisions": {
    "include": "Emit a want. classifier_labels feed the semantic-rejection step; radius_m overrides the default spatial-join radius.",
    "exclude": "Never emit: the item is an organization, event, abstract entity, or administrative region — a photo of its coordinates would not depict it.",
    "exclude_privacy": "Never emit, and wins over any include-class on the same item: photographing the subject targets a private residence or similar.",
    "review": "Plausibly photographable but unresolved (vague extent, org-vs-building ambiguity, or dignity concerns). Kept out of bundles, surfaced in the compile report for triage. Unmapped classes default to review."
  },
  "version": "0.1",
  "default_radius_m": 250,
